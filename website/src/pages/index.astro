---
import Layout from '../layouts/Layout.astro';
import StatCard from '../components/StatCard.astro';

const highlights = [
  { label: 'Best F1 Score',       value: '0.8734', sub: 'LightGBM + AGSS on creditcard',        color: 'green'  as const },
  { label: 'vs Paper Best',       value: '+4.8%',  sub: 'LightGBM beats paper on creditcard',   color: 'green'  as const },
  { label: 'Avg Reproduction Gap',value: '~2%',    sub: 'Across all 8 deep learning runs',      color: 'indigo' as const },
  { label: 'Experiments',         value: '12+',    sub: 'Models × datasets × samplers',         color: 'amber'  as const },
];

const models = [
  { name: 'LightGBM',    f1: 0.8734, color: '#34d399', beat: true  },
  { name: 'XGBoost',     f1: 0.8656, color: '#10b981', beat: true  },
  { name: 'LSTM',        f1: 0.8377, color: '#818cf8', beat: false },
  { name: 'RNN',         f1: 0.8294, color: '#a78bfa', beat: false },
  { name: 'Transformer', f1: 0.8241, color: '#c084fc', beat: false },
  { name: 'GAN',         f1: 0.7497, color: '#f59e0b', beat: false },
];

const timeline = [
  { phase: 'Phase 1', title: 'Credit Card Oversampling',   desc: 'LSTM & RNN with AGSS, SMOTE, ADASYN, ROS',           status: 'done' },
  { phase: 'Phase 1', title: 'Credit Card Undersampling',  desc: 'LSTM & RNN with AGSS, RUS, TomekLinks, ENN',         status: 'done' },
  { phase: 'Phase 2', title: 'German Credit Oversampling', desc: 'LSTM & RNN with all samplers',                       status: 'done' },
  { phase: 'Phase 2', title: 'German Credit Undersampling',desc: 'RNN beats paper by +2.7%',                           status: 'done' },
  { phase: 'Extra',   title: 'GAN Pipeline',               desc: 'FraudGAN on both datasets',                          status: 'done' },
  { phase: 'Extra',   title: 'Transformer Pipeline',       desc: 'Tuned d_model=128 closes gap from 14.7%→2.5%',       status: 'done' },
  { phase: 'New',     title: 'LightGBM + XGBoost',         desc: 'Beats paper by +4.8% — best result overall',         status: 'new'  },
];
---

<Layout title="Home">

  <!-- Hero -->
  <section class="relative min-h-[92vh] flex items-center justify-center hero-glow overflow-hidden">
    <div class="absolute inset-0 opacity-30"
         style="background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.05) 1px, transparent 0); background-size:40px 40px;">
    </div>

    <div class="relative max-w-5xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass text-xs text-primary-400 font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-accent-400 animate-pulse"></span>
        IEEE Access 2026 · Reproduction + Extension
      </div>

      <h1 class="text-5xl md:text-7xl font-extrabold leading-tight mb-6">
        <span class="gradient-text">AGSS</span>
        <span class="text-white"> Fraud</span><br/>
        <span class="text-white">Detection</span>
      </h1>

      <p class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mb-10">
        Full reproduction of <em class="text-gray-200 not-italic font-semibold">Nama & Sharmila Banu (2026)</em> — AGSS
        oversampling with LSTM, RNN, GAN, Transformer, LightGBM & XGBoost across two benchmark fraud datasets.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <a href="/creditcard"
           class="px-8 py-3.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-semibold
                  transition-all duration-200 hover:shadow-xl hover:shadow-primary-600/40 hover:-translate-y-0.5">
          Explore Results →
        </a>
        <a href="/algorithm"
           class="px-8 py-3.5 rounded-xl glass glass-hover font-semibold text-gray-300 hover:text-white">
          How AGSS Works
        </a>
      </div>

      <!-- Model badges -->
      <div class="flex flex-wrap justify-center gap-3">
        {models.map(m => (
          <div class={`glass px-4 py-2 rounded-full flex items-center gap-2 text-sm
                       ${m.beat ? 'border border-accent-500/40' : ''}`}>
            <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background:${m.color}`}></span>
            <span class="text-gray-400">{m.name}</span>
            <span class="font-mono font-bold" style={`color:${m.color}`}>{m.f1}</span>
            {m.beat && <span class="text-accent-400 text-xs font-semibold">✓ beats paper</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="max-w-7xl mx-auto px-6 py-20">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {highlights.map((h, i) => <StatCard {...h} delay={i * 100} />)}
    </div>
  </section>

  <!-- Best result callout -->
  <section class="max-w-7xl mx-auto px-6 pb-16">
    <div data-animate
         class="glass rounded-3xl p-8 md:p-12 border-accent-500/20
                bg-gradient-to-br from-accent-500/10 to-primary-600/10">
      <div class="flex flex-col md:flex-row items-center gap-8">
        <div class="flex-1">
          <p class="text-xs font-semibold text-accent-400 uppercase tracking-widest mb-3">Best Result — Extension Beyond Paper</p>
          <h2 class="text-4xl font-extrabold text-white mb-3">LightGBM + AGSS</h2>
          <p class="text-gray-400 mb-6">
            Gradient boosting with density-weighted AGSS oversampling achieves the highest F1
            in the entire project — beating the paper's best deep learning result by
            <span class="text-accent-400 font-bold">+4.8%</span> while training in under 15 minutes.
          </p>
          <div class="flex flex-wrap gap-6">
            {[['F1-score','0.8734','text-accent-400'],['Precision','0.9434','text-primary-400'],
              ['ROC-AUC','0.9808','text-purple-400'],['Train time','<15 min','text-amber-400']].map(([l,v,c]) => (
              <div class="text-center">
                <p class={`text-3xl font-bold ${c}`}>{v}</p>
                <p class="text-xs text-gray-500 mt-1">{l}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="md:w-48 text-center flex-shrink-0">
          <div class="w-36 h-36 mx-auto rounded-full border-4 border-accent-500/50
                      flex flex-col items-center justify-center
                      shadow-[0_0_30px_rgba(52,211,153,0.3)]">
            <p class="text-4xl font-extrabold text-accent-400">+4.8%</p>
            <p class="text-xs text-gray-400 mt-1">vs paper</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <h2 data-animate class="text-2xl font-bold text-white mb-8">Experiment Timeline</h2>
    <div class="space-y-3">
      {timeline.map((t, i) => (
        <div data-animate style={`animation-delay:${i * 60}ms`}
             class={`glass glass-hover rounded-xl px-6 py-4 flex items-center gap-5
                     ${t.status === 'new' ? 'border-accent-500/30 bg-accent-500/5' : ''}`}>
          <span class={`text-xs font-bold px-2.5 py-1 rounded-full whitespace-nowrap
            ${t.phase === 'Phase 1' ? 'bg-primary-600/20 text-primary-400' :
              t.phase === 'Phase 2' ? 'bg-purple-600/20 text-purple-400' :
              t.phase === 'New'     ? 'bg-accent-600/20 text-accent-400' :
                                      'bg-amber-600/20 text-amber-400'}`}>
            {t.phase}
          </span>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-white">{t.title}</p>
            <p class="text-xs text-gray-500 truncate">{t.desc}</p>
          </div>
          <span class="text-lg flex-shrink-0">
            {t.status === 'new' ? '⭐' : '✅'}
          </span>
        </div>
      ))}
    </div>
  </section>

</Layout>
