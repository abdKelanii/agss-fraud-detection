<style>
  .slide-label { font-size:.65rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; margin-bottom:.5rem; }
  .slide-h2 { font-size:2.25rem; font-weight:800; color:white; margin-bottom:1.5rem; line-height:1.2; }

  @keyframes deckIn {
    from { opacity:0; transform:scale(0.95) translateY(20px); }
    to   { opacity:1; transform:scale(1)    translateY(0);    }
  }
  #deck { animation: deckIn .6s cubic-bezier(.16,1,.3,1) both; }

  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 0 1rem;
    opacity: 0;
    transform: translateX(0) scale(1);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .slide.active {
    opacity: 1;
    transform: translateX(0) scale(1);
    pointer-events: all;
  }

  @keyframes barPulse {
    0%   { box-shadow: 0 0 0   rgba(52,211,153,0);   }
    40%  { box-shadow: 0 0 12px rgba(52,211,153,0.7); }
    100% { box-shadow: 0 0 0   rgba(52,211,153,0);   }
  }
  #progress.pulse { animation: barPulse .55s ease forwards; }

  #btn-prev:active, #btn-next:active { transform: scale(0.88); }
  #btn-prev, #btn-next { transition: transform .12s ease, opacity .2s ease, background .2s ease; }
</style>

<script>
  const slides    = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const total     = slides.length;
  let   cur       = 0;
  let   animating = false;

  const progressEl = document.getElementById('progress')!;
  const counterEl  = document.getElementById('counter')!;
  const dotsEl     = document.getElementById('dots')!;
  const btnPrev    = document.getElementById('btn-prev') as HTMLButtonElement;
  const btnNext    = document.getElementById('btn-next') as HTMLButtonElement;
  const deck       = document.getElementById('deck')!;

  slides.forEach((_, i) => {
    const d = document.createElement('button');
    d.addEventListener('click', () => goTo(i));
    dotsEl.appendChild(d);
  });

  function updateUI() {
    progressEl.style.width = `${((cur + 1) / total) * 100}%`;
    progressEl.classList.remove('pulse');
    void progressEl.offsetWidth;
    progressEl.classList.add('pulse');

    counterEl.textContent = `${cur + 1} / ${total}`;
    btnPrev.style.opacity = cur === 0       ? '.3' : '1';
    btnNext.style.opacity = cur === total-1 ? '.3' : '1';

    dotsEl.querySelectorAll('button').forEach((d, i) => {
      (d as HTMLElement).style.cssText = i === cur
        ? 'width:1rem;height:.375rem;border-radius:9999px;background:#34d399;transition:all .35s cubic-bezier(.16,1,.3,1)'
        : 'width:.375rem;height:.375rem;border-radius:9999px;background:rgba(255,255,255,.18);transition:all .35s cubic-bezier(.16,1,.3,1)';
    });
  }

  function goTo(n: number) {
    if (n === cur || n < 0 || n >= total || animating) return;
    animating = true;

    const dir    = n > cur ? 1 : -1;
    const prevEl = slides[cur];
    const nextEl = slides[n];

    const enterFrom = dir > 0 ? 'translateX(72px) scale(.97)' : 'translateX(-72px) scale(.97)';
    const exitTo    = dir > 0 ? 'translateX(-56px) scale(.97)' : 'translateX(56px) scale(.97)';

    nextEl.style.cssText = `opacity:0; transform:${enterFrom}; transition:none; pointer-events:none;`;
    void nextEl.offsetWidth;

    requestAnimationFrame(() => {
      prevEl.style.cssText = `
        opacity:0;
        transform:${exitTo};
        transition: opacity .28s ease, transform .28s cubic-bezier(.4,0,1,1);
        pointer-events:none;
      `;
      nextEl.style.cssText = `
        opacity:1;
        transform:translateX(0) scale(1);
        transition: opacity .5s cubic-bezier(.16,1,.3,1), transform .5s cubic-bezier(.16,1,.3,1);
        pointer-events:all;
      `;
    });

    cur = n;
    updateUI();

    setTimeout(() => {
      prevEl.classList.remove('active');
      prevEl.style.cssText = '';
      nextEl.classList.add('active');
      nextEl.style.cssText = '';
      animating = false;
    }, 540);
  }

  document.getElementById('exit-btn')?.addEventListener('click', e => {
    e.preventDefault();
    const href = (e.currentTarget as HTMLAnchorElement).href;
    deck.style.transition = 'opacity .35s ease, transform .35s cubic-bezier(.4,0,1,1)';
    deck.style.opacity    = '0';
    deck.style.transform  = 'scale(0.94) translateY(-18px)';
    setTimeout(() => { window.location.href = href; }, 370);
  });

  // ── Fullscreen ────────────────────────────────────────────────────────────
  const fsBtn      = document.getElementById('fs-btn')!;
  const fsExpand   = document.getElementById('fs-expand')!;
  const fsCompress = document.getElementById('fs-compress')!;

  fsBtn.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen();
    } else {
      document.exitFullscreen();
    }
  });

  document.addEventListener('fullscreenchange', () => {
    const isFs = !!document.fullscreenElement;
    fsExpand.classList.toggle('hidden', isFs);
    fsCompress.classList.toggle('hidden', !isFs);
  });

  // ── Keyboard navigation ───────────────────────────────────────────────────
  document.addEventListener('keydown', e => {
    if (['ArrowRight', ' ', 'Enter'].includes(e.key)) { e.preventDefault(); goTo(cur + 1); }
    if (e.key === 'ArrowLeft')                         { e.preventDefault(); goTo(cur - 1); }
    if (e.key === 'Escape' && !document.fullscreenElement) {
      document.getElementById('exit-btn')?.click();
    }
  });

  // ── Touch swipe ──────────────────────────────────────────────────────────
  let tx = 0;
  const wrap = document.getElementById('slides-wrap')!;
  wrap.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive:true });
  wrap.addEventListener('touchend',   e => {
    const dx = tx - e.changedTouches[0].clientX;
    if (Math.abs(dx) > 48) dx > 0 ? goTo(cur + 1) : goTo(cur - 1);
  });

  setTimeout(() => {
    const h = document.getElementById('kbd-hint');
    if (h) h.style.opacity = '0';
  }, 3500);

  updateUI();
</script>
