---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Presentation">

<div id="deck" class="fixed inset-0 z-[100] bg-[#0a0a0f] flex flex-col" style="top:0">

  <!-- Progress bar -->
  <div id="progress" class="absolute top-0 left-0 h-[3px] z-10 transition-all duration-500"
       style="width:5.88%; background: linear-gradient(90deg,#6366f1,#34d399)"></div>

  <!-- Top bar -->
  <div class="absolute top-4 right-5 flex items-center gap-3 z-10">
    <span id="counter" class="text-xs font-mono text-gray-500">1 / 17</span>
    <button id="fs-btn" title="Toggle fullscreen"
            class="text-gray-400 hover:text-white transition-colors p-1.5 rounded-full"
            style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)">
      <svg id="fs-expand" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
      </svg>
      <svg id="fs-compress" class="w-3.5 h-3.5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 9V4M9 9H4M9 9L4 4m11 5h-4m4 0V4m0 5l-5-5M9 15v4m0-4H4m5 4l-5 5m11-5h4m-4 0v4m0-4l5 5"/>
      </svg>
    </button>
    <a id="exit-btn" href="/" class="text-xs text-gray-400 hover:text-white transition-colors px-3 py-1.5 rounded-full"
       style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)">
      ✕ Exit
    </a>
  </div>

  <!-- Slides -->
  <div id="slides-wrap" class="relative flex-1 overflow-hidden">

    <!-- ───────── SLIDE 1: Title ───────── -->
    <section class="slide active">
      <div class="max-w-3xl mx-auto px-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs text-primary-400 font-medium mb-8"
             style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.2)">
          <span class="w-2 h-2 rounded-full bg-accent-400 animate-pulse"></span>
          IEEE Access 2026 · Reproduction + Extension
        </div>
        <h1 class="text-6xl font-extrabold leading-tight mb-5">
          <span class="gradient-text">AGSS</span>
          <span class="text-white"> Fraud</span><br/>
          <span class="text-white">Detection</span>
        </h1>
        <p class="text-lg text-gray-400 mb-10">
          Full reproduction of <span class="text-gray-200 font-semibold">Nama & Sharmila Banu (2026)</span><br/>
          + extension to gradient boosting models
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          {[['6 Models','#818cf8'],['2 Datasets','#34d399'],['17 Experiments','#f59e0b'],['Best: +4.8% vs Paper','#34d399']].map(([l,c]) => (
            <span class="glass px-4 py-2 rounded-full text-sm font-semibold" style={`color:${c}`}>{l}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────── SLIDE 2: The Problem ───────── -->
    <section class="slide">
      <div class="max-w-4xl mx-auto px-10 w-full">
        <p class="slide-label text-rose-400">The Challenge</p>
        <h2 class="slide-h2">Financial Fraud Detection</h2>
        <div class="grid md:grid-cols-2 gap-5">
          <div class="space-y-3">
            {[
              ['💰','$32B+ annual losses','Global credit card fraud costs escalate every year'],
              ['⚖️','Severe class imbalance','Only 0.17% of transactions are fraudulent'],
              ['🤖','Model bias','Standard classifiers predict "not fraud" for everything'],
              ['🎯','Goal','High recall on fraud without flooding with false positives'],
            ].map(([icon,title,desc]) => (
              <div class="glass rounded-xl p-4 flex gap-3">
                <span class="text-xl">{icon}</span>
                <div>
                  <p class="text-sm font-semibold text-white">{title}</p>
                  <p class="text-xs text-gray-400 mt-0.5">{desc}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="glass rounded-2xl p-6 flex flex-col justify-center gap-6">
            <div>
              <p class="text-xs font-semibold text-primary-400 uppercase tracking-wider mb-3">Credit Card (Kaggle)</p>
              <p class="text-sm text-gray-400">284,807 transactions</p>
              <p class="text-sm text-gray-400">492 fraud — <span class="text-rose-400 font-mono font-bold">0.17%</span></p>
              <p class="text-sm text-gray-400">30 PCA features</p>
            </div>
            <div class="border-t border-white/5 pt-5">
              <p class="text-xs font-semibold text-purple-400 uppercase tracking-wider mb-3">German Credit (UCI)</p>
              <p class="text-sm text-gray-400">1,000 loan records</p>
              <p class="text-sm text-gray-400">300 bad credit — <span class="text-amber-400 font-mono font-bold">30%</span></p>
              <p class="text-sm text-gray-400">20 mixed features</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── SLIDE 3: Existing Methods ───────── -->
    <section class="slide">
      <div class="max-w-5xl mx-auto px-10 w-full">
        <p class="slide-label text-amber-400">Background</p>
        <h2 class="slide-h2">Oversampling Approaches</h2>
        <div class="grid grid-cols-4 gap-4 mb-6">
          {[
            {name:'ROS',    pro:'Fastest baseline',           con:'Pure duplication — no new diversity',   accent:false},
            {name:'SMOTE',  pro:'Simple interpolation',       con:'Generates near noisy boundary points',  accent:false},
            {name:'ADASYN', pro:'Focuses on hard samples',    con:'Amplifies noisy boundary regions',      accent:false},
            {name:'AGSS',   pro:'Cluster-aware, high prec.',  con:'Slower — but far more targeted',        accent:true },
          ].map(m => (
            <div class={`glass rounded-2xl p-5 ${m.accent ? 'border-accent-500/30 bg-accent-500/5' : ''}`}>
              <p class={`text-xl font-extrabold mb-3 ${m.accent ? 'text-accent-400' : 'text-gray-300'}`}>{m.name}</p>
              <p class="text-xs text-gray-300 mb-2">✓ {m.pro}</p>
              <p class="text-xs text-gray-500">✗ {m.con}</p>
            </div>
          ))}
        </div>
        <div class="glass rounded-xl p-5 border-accent-500/20 bg-accent-500/5">
          <p class="text-sm text-gray-300">
            <span class="text-accent-400 font-bold">AGSS key insight:</span> Generate synthetic samples only within
            <em class="text-gray-200"> dense, cluster-verified</em> minority regions —
            avoiding the noisy boundaries that fool SMOTE and ADASYN.
          </p>
        </div>
      </div>
    </section>

    <!-- ───────── SLIDE 4: Visual Comparison ───────── -->
    <section class="slide">
      <div class="max-w-5xl mx-auto px-8 w-full">
        <p class="slide-label text-accent-400">Visual Proof</p>
        <h2 class="slide-h2" style="margin-bottom:1rem">SMOTE vs AGSS — Same Data, Different Samples</h2>

        <div class="glass rounded-2xl overflow-hidden mb-4" style="border-color:rgba(255,255,255,0.08)">
          <img src="/figures/compare_smote_agss_2panel.png"
               alt="SMOTE vs AGSS visual comparison"
               class="w-full object-contain" style="max-height:340px" />
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div class="glass rounded-xl p-4" style="border-color:rgba(251,191,36,0.2);background:rgba(251,191,36,0.04)">
            <p class="text-xs font-bold text-amber-400 mb-1">SMOTE problem</p>
            <p class="text-xs text-gray-400">Interpolates between <em class="text-gray-200">all</em> k-NN pairs — including noisy outliers near the decision boundary. Synthetic chain pollutes the majority region.</p>
          </div>
          <div class="glass rounded-xl p-4" style="border-color:rgba(52,211,153,0.2);background:rgba(52,211,153,0.04)">
            <p class="text-xs font-bold text-accent-400 mb-1">AGSS solution</p>
            <p class="text-xs text-gray-400">DBSCAN first identifies <em class="text-gray-200">dense cluster cores</em>. Synthesis happens only inside dashed circles — noisy boundary points are ignored.</p>
          </div>
          <div class="glass rounded-xl p-4" style="border-color:rgba(129,140,248,0.2);background:rgba(129,140,248,0.04)">
            <p class="text-xs font-bold text-primary-400 mb-1">Why it matters</p>
            <p class="text-xs text-gray-400">Cleaner synthetic samples → fewer false fraud signals → higher precision without sacrificing recall. Confirmed by +4.8% F1 on Credit Card.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── SLIDE 5: Original → SMOTE → AGSS progression ───────── -->
    <section class="slide">
      <div class="max-w-5xl mx-auto px-8 w-full">
        <p class="slide-label text-accent-400">Step by Step</p>
        <h2 class="slide-h2" style="margin-bottom:1rem">Original Data → Oversampled</h2>

        <div class="glass rounded-2xl overflow-hidden mb-5" style="border-color:rgba(255,255,255,0.08)">
          <img src="/figures/compare_smote_agss_3panel.png"
               alt="Original data, SMOTE and AGSS comparison"
               class="w-full object-contain" style="max-height:340px" />
        </div>

        <div class="grid grid-cols-3 gap-4 text-center">
          {[
            ['Original', 'Two tight minority clusters (purple/lavender) + 3 noisy boundary points (×)', 'text-gray-400'],
            ['SMOTE', 'Orange diamonds chain through the noisy points — spreading into the majority cloud', 'text-amber-400'],
            ['AGSS', 'Green diamonds stay tightly inside each cluster core — noisy points are skipped', 'text-accent-400'],
          ].map(([title, desc, c]) => (
            <div class="glass rounded-xl p-4">
              <p class={`text-sm font-bold mb-1 ${c}`}>{title}</p>
              <p class="text-xs text-gray-400">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────── SLIDE 6: The Paper ───────── -->
    <section class="slide">
      <div class="max-w-4xl mx-auto px-10 w-full">
        <p class="slide-label text-primary-400">Source Paper</p>
        <h2 class="slide-h2">Nama & Sharmila Banu, 2026</h2>
        <p class="text-gray-400 text-sm mb-7">IEEE Access · DOI: 10.1109/ACCESS.2025.3649833</p>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider mb-3">Paper's Reported Results</p>
            <div class="space-y-3">
              {[
                {dataset:'Credit Card', model:'LSTM + AGSS', f1:'0.8333', note:'Oversampling',    color:'text-primary-400'},
                {dataset:'German',      model:'RNN + AGSS',  f1:'0.8489', note:'Oversampling',    color:'text-purple-400'},
                {dataset:'German',      model:'RNN + AGSS',  f1:'0.8601', note:'Undersampling ★', color:'text-accent-400'},
              ].map(r => (
                <div class="glass rounded-xl px-4 py-3 flex justify-between items-center">
                  <div>
                    <p class={`text-sm font-semibold ${r.color}`}>{r.dataset}</p>
                    <p class="text-xs text-gray-400">{r.model} · {r.note}</p>
                  </div>
                  <p class={`font-mono font-bold text-xl ${r.color}`}>{r.f1}</p>
                </div>
              ))}
            </div>
            <p class="text-xs text-gray-600 mt-3">★ German uses F1 on good-credit class (majority) — not fraud</p>
          </div>
          <div class="glass rounded-2xl p-6">
            <p class="text-xs text-gray-500 uppercase tracking-wider mb-4">What We Did</p>
            <div class="space-y-2.5 text-sm">
              {[
                ['✓','Reproduce all paper experiments','text-accent-400'],
                ['✓','5-fold stratified cross-validation','text-accent-400'],
                ['✓','Same datasets, same metrics','text-accent-400'],
                ['+','Add Transformer architecture','text-primary-400'],
                ['+','Add GAN-based oversampling','text-primary-400'],
                ['+','Add LightGBM & XGBoost (extension)','text-amber-400'],
              ].map(([icon,text,c]) => (
                <p class="flex gap-2"><span class={`font-bold ${c}`}>{icon}</span><span class="text-gray-400">{text}</span></p>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── SLIDE 7: AGSS Algorithm ───────── -->
    <section class="slide">
      <div class="max-w-4xl mx-auto px-10 w-full">
        <p class="slide-label text-accent-400">Core Algorithm</p>
        <h2 class="slide-h2">How AGSS Works</h2>
        <div class="grid md:grid-cols-2 gap-5">
          <div class="space-y-2.5">
            {[
              ['1','Extract minority samples',  'Isolate all fraud/bad-credit rows from the training fold','text-primary-400'],
              ['2','DBSCAN clustering',         'eps=0.8, min_samples=3. Adaptive eps search if <2 clusters found','text-purple-400'],
              ['3','KNN within each cluster',   'k=3 neighbours; density-weighted base point selection','text-accent-400'],
              ['4','Curvature interpolation',   'x_syn = p + α(q−p) + γ·sin(θ)·perp(q−p)','text-amber-400'],
              ['5','Combine & train',           'Merge synthetic + real data — for this fold only','text-rose-400'],
            ].map(([n,title,desc,c]) => (
              <div class="glass rounded-xl px-4 py-3 flex gap-3 border-l-2 border-white/10">
                <span class={`font-extrabold text-lg w-5 flex-shrink-0 ${c}`}>{n}</span>
                <div>
                  <p class={`text-sm font-bold ${c}`}>{title}</p>
                  <p class="text-xs text-gray-400 mt-0.5">{desc}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="flex flex-col gap-4">
            <div class="glass rounded-2xl p-5 border-amber-500/20 bg-amber-500/5 flex-1">
              <p class="text-sm font-bold text-amber-400 mb-3">Interpolation Formula</p>
              <p class="font-mono text-lg text-amber-300 text-center py-4">
                x<sub>syn</sub> = p + α·(q−p) + γ·sin(θ)·perp(q−p)
              </p>
              <div class="grid grid-cols-2 gap-2">
                {[['α','Uniform(0,1) — linear weight'],['γ','Uniform(0,0.1) — curvature'],['θ','Uniform(0,2π) — angle'],['perp','Random ⊥ unit vector']].map(([s,d]) => (
                  <div class="text-xs">
                    <span class="font-mono text-amber-400 font-bold">{s} </span>
                    <span class="text-gray-500">{d}</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="glass rounded-xl p-4 bg-accent-500/5 border-accent-500/20">
              <p class="text-xs text-accent-400 font-semibold mb-1">Our AGSS enhancement</p>
              <p class="text-xs text-gray-400">Multi-cluster eps search (p20→p5 of k-NN distances) + density-weighted base point sampling</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── SLIDE 8: Setup ───────── -->
    <section class="slide">
      <div class="max-w-4xl mx-auto px-10 w-full">
        <p class="slide-label text-primary-400">Methodology</p>
        <h2 class="slide-h2">Experimental Setup</h2>
        <div class="grid md:grid-cols-3 gap-4">
          <div class="glass rounded-2xl p-5">
            <p class="text-xs text-gray-500 uppercase tracking-wider mb-3">Models</p>
            <div class="space-y-2">
              {[['LSTM','#818cf8'],['RNN','#a78bfa'],['GAN (FraudGAN)','#f59e0b'],['Transformer','#c084fc'],['LightGBM ★','#34d399'],['XGBoost ★','#10b981']].map(([n,c]) => (
                <div class="flex items-center gap-2 text-sm">
                  <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background:${c}`}></span>
                  <span class="text-gray-300">{n}</span>
                </div>
              ))}
              <p class="text-xs text-gray-500 pt-1">★ Extension — not in paper</p>
            </div>
          </div>
          <div class="glass rounded-2xl p-5">
            <p class="text-xs text-gray-500 uppercase tracking-wider mb-3">Samplers</p>
            <div class="space-y-3">
              <div>
                <p class="text-xs text-accent-400 font-semibold mb-1">Oversampling</p>
                {['AGSS','SMOTE','ADASYN','ROS'].map(s => <p class="text-sm text-gray-400 ml-2">· {s}</p>)}
              </div>
              <div>
                <p class="text-xs text-primary-400 font-semibold mb-1">Undersampling</p>
                {['TomekLinks','RUS','ENN','AGSS-under'].map(s => <p class="text-sm text-gray-400 ml-2">· {s}</p>)}
              </div>
            </div>
          </div>
          <div class="glass rounded-2xl p-5">
            <p class="text-xs text-gray-500 uppercase tracking-wider mb-3">Evaluation</p>
            <div class="space-y-3 text-sm">
              <div>
                <p class="text-xs text-amber-400 font-semibold mb-1">Protocol</p>
                <p class="text-gray-400">5-fold stratified CV</p>
                <p class="text-gray-400">Threshold sweep 0.1→0.99</p>
              </div>
              <div>
                <p class="text-xs text-amber-400 font-semibold mb-1">Metrics</p>
                {['F1-score (primary)','Precision','Recall','ROC-AUC'].map(m => <p class="text-gray-400">· {m}</p>)}
              </div>
              <div>
                <p class="text-xs text-amber-400 font-semibold mb-1">Hardware</p>
                <p class="text-gray-400">Apple M-series (MPS)</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── SLIDE 9: Credit Card Results ───────── -->
    <section class="slide">
      <div class="max-w-4xl mx-auto px-10 w-full">
        <p class="slide-label text-primary-400">Phase 1 Results</p>
        <h2 class="slide-h2">Credit Card Dataset</h2>
        <p class="text-gray-400 text-sm mb-6">F1-score on fraud class · Paper target: <span class="text-primary-400 font-mono font-bold">0.8333</span> (LSTM+AGSS oversampling)</p>
        <div class="space-y-3">
          {[
            {model:'LightGBM + AGSS',  f1:0.8734, color:'#34d399', delta:'+4.8%',    note:'extension'},
            {model:'XGBoost + AGSS',   f1:0.8656, color:'#10b981', delta:'+3.9%',    note:'extension'},
            {model:'LSTM + AGSS',      f1:0.8236, color:'#818cf8', delta:'-1.2%',    note:'over'},
            {model:'RNN + AGSS',       f1:0.8077, color:'#a78bfa', delta:'-3.1%',    note:'over'},
            {model:'GAN + AGSS',       f1:0.7497, color:'#f59e0b', delta:'-10.0%',   note:'over'},
            {model:'Transformer+AGSS', f1:0.3922, color:'#c084fc', delta:'untuned ★', note:'over'},
          ].map(r => (
            <div class="flex items-center gap-4">
              <div class="w-44 flex-shrink-0 flex items-center gap-2">
                <p class="text-sm text-gray-200 truncate">{r.model}</p>
              </div>
              <div class="flex-1 relative h-8 glass rounded-lg overflow-hidden">
                <div class="h-full rounded-lg" style={`width:${r.f1*100}%; background:${r.color}22; border-right:2px solid ${r.color}`}></div>
                <div class="absolute inset-0 flex items-center px-3">
                  <span class="font-mono font-bold text-sm" style={`color:${r.color}`}>{r.f1.toFixed(4)}</span>
                </div>
                <div class="absolute top-0 bottom-0 w-px bg-white/40" style="left:83.33%"></div>
              </div>
              <span class={`text-xs font-bold w-24 text-right flex-shrink-0 ${r.delta.startsWith('+') ? 'text-accent-400' : r.delta === 'untuned ★' ? 'text-gray-500 italic' : 'text-gray-500'}`}>{r.delta}</span>
            </div>
          ))}
        </div>
        <div class="flex gap-6 mt-4">
          <p class="text-xs text-gray-500">Vertical line = paper target (0.8333)</p>
          <p class="text-xs text-gray-600">★ Transformer on CC had no threshold sweep — see slide 13 for tuned result on German</p>
        </div>
      </div>
    </section>

    <!-- ───────── SLIDE 10: German Results ───────── -->
    <section class="slide">
      <div class="max-w-4xl mx-auto px-10 w-full">
        <p class="slide-label text-purple-400">Phase 2 Results</p>
        <h2 class="slide-h2">German Credit Dataset</h2>
        <p class="text-gray-400 text-sm mb-6">F1-score on <em class="text-gray-300">good credit class</em> · Paper target: <span class="text-purple-400 font-mono font-bold">0.8489</span> (RNN+AGSS over)</p>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider mb-3">Oversampling — All models + AGSS</p>
            <div class="space-y-2">
              {[
                {m:'XGBoost',    f1:0.8386,color:'#10b981'},
                {m:'LightGBM',   f1:0.8343,color:'#34d399'},
                {m:'RNN',        f1:0.8294,color:'#a78bfa'},
                {m:'LSTM',       f1:0.8286,color:'#818cf8'},
                {m:'Transformer',f1:0.8241,color:'#c084fc'},
                {m:'GAN',        f1:0.8235,color:'#f59e0b'},
              ].map(r => (
                <div class="flex items-center gap-3">
                  <span class="w-24 text-sm text-gray-300 flex-shrink-0">{r.m}</span>
                  <div class="flex-1 relative h-6 glass rounded overflow-hidden">
                    <div class="h-full" style={`width:${(r.f1/0.9)*100}%; background:${r.color}33; border-right:2px solid ${r.color}`}></div>
                    <div class="absolute top-0 bottom-0 w-px bg-white/30" style="left:94.3%"></div>
                  </div>
                  <span class="font-mono text-sm font-bold w-16 text-right" style={`color:${r.color}`}>{r.f1.toFixed(4)}</span>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider mb-3">Undersampling (selected)</p>
            <div class="space-y-2.5">
              {[
                {m:'RNN',  s:'TomekLinks',f1:0.8328,best:true},
                {m:'RNN',  s:'RUS',       f1:0.8298,best:false},
                {m:'LSTM', s:'TomekLinks',f1:0.8297,best:false},
                {m:'RNN',  s:'AGSS',      f1:0.8145,best:false},
              ].map(r => (
                <div class={`glass rounded-xl px-4 py-2.5 flex justify-between items-center ${r.best ? 'border-purple-500/30 bg-purple-500/5' : ''}`}>
                  <div>
                    <p class="text-sm font-semibold text-gray-200">{r.m} + {r.s}</p>
                    <p class="text-xs text-gray-500">{((r.f1/0.8489-1)*100).toFixed(1)}% vs paper over</p>
                  </div>
                  <p class="font-mono font-bold text-purple-400">{r.f1.toFixed(4)}</p>
                </div>
              ))}
            </div>
