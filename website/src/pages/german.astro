---
import Layout from '../layouts/Layout.astro';

const paperOver  = 0.8489; // RNN+AGSS oversampling
const paperUnder = 0.8601; // RNN+AGSS undersampling

const rows = [
  // ── Oversampling ──────────────────────────────────────────────────────────
  { model:'XGBoost',    sampler:'AGSS',       type:'over',  f1:0.8386, prec:0.7329, rec:0.9800, roc:0.7300, thresh:0.90,  color:'#10b981' },
  { model:'LightGBM',   sampler:'AGSS',       type:'over',  f1:0.8483, prec:0.7634, rec:0.9543, roc:0.7253, thresh:0.95,  color:'#34d399' },
  { model:'RNN',        sampler:'AGSS',       type:'over',  f1:0.8294, prec:null,   rec:null,   roc:null,   thresh:null,  color:'#a78bfa' },
  { model:'LSTM',       sampler:'AGSS',       type:'over',  f1:0.8286, prec:null,   rec:null,   roc:null,   thresh:null,  color:'#818cf8' },
  { model:'Transformer',sampler:'AGSS',       type:'over',  f1:0.8241, prec:null,   rec:null,   roc:0.6494, thresh:0.90,  color:'#c084fc' },
  { model:'GAN',        sampler:'AGSS',       type:'over',  f1:0.8235, prec:null,   rec:null,   roc:null,   thresh:null,  color:'#f59e0b' },
  // ── Undersampling ─────────────────────────────────────────────────────────
  { model:'RNN',        sampler:'TomekLinks', type:'under', f1:0.8328, prec:null,   rec:null,   roc:0.7423, thresh:null,  color:'#a78bfa' },
  { model:'RNN',        sampler:'RUS',        type:'under', f1:0.8298, prec:null,   rec:null,   roc:0.7362, thresh:null,  color:'#a78bfa' },
  { model:'LSTM',       sampler:'TomekLinks', type:'under', f1:0.8297, prec:null,   rec:null,   roc:0.7229, thresh:null,  color:'#818cf8' },
  { model:'LSTM',       sampler:'RUS',        type:'under', f1:0.8287, prec:null,   rec:null,   roc:0.7125, thresh:null,  color:'#818cf8' },
  { model:'RNN',        sampler:'AGSS',       type:'under', f1:0.8145, prec:null,   rec:null,   roc:0.6994, thresh:null,  color:'#a78bfa' },
].sort((a, b) => b.f1 - a.f1);
---

<Layout title="German Credit Results">
  <section class="max-w-6xl mx-auto px-6 py-20">

    <!-- Header -->
    <div data-animate class="mb-10">
      <p class="text-xs font-semibold text-purple-400 uppercase tracking-widest mb-2">Phase 2</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">German Credit Dataset</h1>
      <p class="text-gray-400 max-w-2xl">
        1,000 samples · 300 bad credit (30%) · 20 mixed features.
        5-fold stratified CV · Metric: <strong class="text-gray-200">F1 on good credit class</strong>.
      </p>
    </div>

    <!-- Paper target pills -->
    <div data-animate class="flex flex-wrap gap-3 mb-10">
      <div class="glass rounded-full px-4 py-1.5 text-xs flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-purple-400"></span>
        <span class="text-gray-400">Paper over target (RNN+AGSS):</span>
        <span class="font-mono font-bold text-purple-400">{paperOver}</span>
      </div>
      <div class="glass rounded-full px-4 py-1.5 text-xs flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
        <span class="text-gray-400">Paper under target (RNN+AGSS):</span>
        <span class="font-mono font-bold text-indigo-400">{paperUnder}</span>
      </div>
    </div>

    <!-- ── Combined bar chart ─────────────────────────────────────────────── -->
    <div data-animate class="glass rounded-2xl p-8 mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-white">F1-Score (good class) — All Models, All Sampling Methods</h2>
        <div class="flex items-center gap-4">
          <div class="flex gap-3">
            <span class="flex items-center gap-1.5 text-xs text-gray-400">
              <span class="inline-block w-8 h-2 rounded" style="background:#a78bfa"></span>Oversampling
            </span>
            <span class="flex items-center gap-1.5 text-xs text-gray-400">
              <span class="inline-block w-8 h-2 rounded" style="background:#6366f1;opacity:.6"></span>Undersampling
            </span>
          </div>
          <button class="fullscreen-btn p-1.5 rounded-lg bg-white/5 hover:bg-white/10 transition-colors text-gray-400 hover:text-white" title="Toggle fullscreen">
            <svg class="expand-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
            <svg class="compress-icon w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9V4M9 9H4M9 9L4 4m11 5h-4m4 0V4m0 5l-5-5M9 15v4m0-4H4m5 4l-5 5m11-5h4m-4 0v4m0-4l5 5"/></svg>
          </button>
        </div>
      </div>

      {rows.map((r, i) => {
        const isOver  = r.type === 'over';
        const barBg   = isOver ? r.color : `${r.color}88`;
        const barBorder = isOver ? 'none' : `2px dashed ${r.color}`;
        const vsRef   = isOver ? paperOver : paperUnder;
        const delta   = ((r.f1 - vsRef) * 100).toFixed(1);
        const pos     = r.f1 >= vsRef;
        return (
          <div class="mb-4">
            <div class="flex justify-between items-center mb-1.5">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style={`background:${r.color}`}></span>
                <span class="text-sm font-semibold text-gray-200 truncate">{r.model}</span>
                <span class={`text-[10px] font-bold px-1.5 py-0.5 rounded flex-shrink-0
                  ${isOver ? 'bg-purple-500/20 text-purple-400' : 'bg-indigo-500/20 text-indigo-400'}`}>
                  {isOver ? 'OVER' : 'UNDER'}
                </span>
                <span class="text-[10px] text-gray-500 flex-shrink-0">{r.sampler}</span>
              </div>
              <div class="flex items-center gap-3 flex-shrink-0 ml-3">
                <span class="font-mono font-bold text-sm" style={`color:${r.color}`}>{r.f1.toFixed(4)}</span>
                <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full
                  ${pos ? 'bg-accent-500/20 text-accent-400' : 'bg-rose-500/10 text-rose-400'}`}>
                  {pos ? '+' : ''}{delta}%
                </span>
              </div>
            </div>
            <div class="relative h-3 bg-white/5 rounded-full overflow-hidden">
              <div class="h-full rounded-full bar-item"
                   style={`width:0%; background:${barBg}; border:${barBorder}; transition:width 1s ease ${i*70}ms`}
                   data-width={`${(r.f1 / 0.9) * 100}%`}></div>
              {/* paper over line */}
              <div class="absolute top-0 bottom-0 w-px bg-purple-400/40" style={`left:${(paperOver/0.9)*100}%`}></div>
              {/* paper under line */}
              <div class="absolute top-0 bottom-0 w-px bg-indigo-400/40" style={`left:${(paperUnder/0.9)*100}%`}></div>
            </div>
          </div>
        );
      })}
      <div class="flex gap-5 mt-3">
        <p class="text-xs text-purple-400/60">Purple line = paper over target ({paperOver})</p>
        <p class="text-xs text-indigo-400/60">Indigo line = paper under target ({paperUnder})</p>
        <p class="text-xs text-gray-500">% delta vs corresponding paper target</p>
      </div>
    </div>

    <!-- ── Transformer tuning callout ────────────────────────────────────── -->
    <div data-animate class="glass rounded-2xl p-7 mb-8 border-purple-500/20 bg-purple-500/5">
      <h2 class="text-base font-bold text-white mb-4">Transformer d_model Tuning</h2>
      <p class="text-gray-400 text-sm mb-5">
        Default d_model=32 gave F1=0.7021 (14.7% gap). Grid search over d_model ∈ {'{'}64,128,256{'}'}
        × epochs ∈ {'{'}300,500{'}'} × lr ∈ {'{'}5e-4,2e-4{'}'} closed the gap to <span class="text-purple-400 font-bold">2.5%</span>.
      </p>
      <div class="grid grid-cols-3 gap-4">
        {[
          { label:'Baseline (d=32)', value:'0.7021', color:'text-rose-400'   },
          { label:'Best (d=128)',    value:'0.8241', color:'text-purple-400' },
          { label:'Paper Target',   value:'0.8489', color:'text-gray-400'   },
        ].map(item => (
          <div class="glass rounded-xl p-4 text-center">
            <p class={`text-2xl font-extrabold font-mono ${item.color}`}>{item.value}</p>
            <p class="text-xs text-gray-500 mt-1">{item.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- ── Combined table ────────────────────────────────────────────────── -->
    <div data-animate class="glass rounded-2xl overflow-hidden">
      <div class="px-6 py-4 border-b border-white/5 flex items-center justify-between">
        <h2 class="font-bold text-white">Detailed Metrics — Oversampling & Undersampling</h2>
        <div class="flex items-center gap-3">
          <div class="flex gap-2 text-xs text-gray-500">
            <span class="px-2 py-0.5 rounded bg-purple-500/15 text-purple-400">OVER</span>
            <span class="px-2 py-0.5 rounded bg-indigo-500/15 text-indigo-400">UNDER</span>
          </div>
          <button class="fullscreen-btn p-1.5 rounded-lg bg-white/5 hover:bg-white/10 transition-colors text-gray-400 hover:text-white" title="Toggle fullscreen">
            <svg class="expand-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
            <svg class="compress-icon w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9V4M9 9H4M9 9L4 4m11 5h-4m4 0V4m0 5l-5-5M9 15v4m0-4H4m5 4l-5 5m11-5h4m-4 0v4m0-4l5 5"/></svg>
          </button>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs text-gray-500 uppercase border-b border-white/5">
              <th class="px-5 py-3 text-left">Model</th>
              <th class="px-5 py-3 text-left">Type</th>
              <th class="px-5 py-3 text-right">F1</th>
              <th class="px-5 py-3 text-right">Precision</th>
              <th class="px-5 py-3 text-right">Recall</th>
              <th class="px-5 py-3 text-right">ROC-AUC</th>
              <th class="px-5 py-3 text-right">Threshold</th>
              <th class="px-5 py-3 text-right">vs Paper</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r, i) => {
              const isOver = r.type === 'over';
              const vsRef  = isOver ? paperOver : paperUnder;
              const delta  = ((r.f1 - vsRef) * 100).toFixed(1);
              const pos    = r.f1 >= vsRef;
              return (
                <tr class={`border-b border-white/5 hover:bg-white/3 transition-colors ${i%2===0?'bg-white/[0.01]':''}`}>
                  <td class="px-5 py-3">
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background:${r.color}`}></span>
                      <span class="font-semibold text-gray-200">{r.model}</span>
                      <span class="text-xs text-gray-500">{r.sampler}</span>
                    </div>
                  </td>
                  <td class="px-5 py-3">
                    <span class={`text-xs font-bold px-2 py-0.5 rounded
                      ${isOver ? 'bg-purple-500/15 text-purple-400' : 'bg-indigo-500/15 text-indigo-400'}`}>
                      {isOver ? 'Oversampling' : 'Undersampling'}
                    </span>
                  </td>
                  <td class="px-5 py-3 text-right font-mono font-bold" style={`color:${r.color}`}>{r.f1.toFixed(4)}</td>
                  <td class="px-5 py-3 text-right font-mono text-gray-400">{r.prec != null ? r.prec.toFixed(4) : '—'}</td>
                  <td class="px-5 py-3 text-right font-mono text-gray-400">{r.rec  != null ? r.rec.toFixed(4)  : '—'}</td>
                  <td class="px-5 py-3 text-right font-mono text-gray-400">{r.roc  != null ? r.roc.toFixed(4)  : '—'}</td>
                  <td class="px-5 py-3 text-right font-mono text-gray-400">{r.thresh != null ? r.thresh : '—'}</td>
                  <td class="px-5 py-3 text-right">
                    <span class={`text-xs font-bold px-2 py-0.5 rounded-full
                      ${pos ? 'bg-accent-500/20 text-accent-400' : 'bg-rose-500/10 text-rose-400'}`}>
                      {pos ? '+' : ''}{delta}%
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

  </section>
</Layout>

<style>
  .glass:fullscreen {
    overflow: auto;
    padding: 2rem;
    background: #0f172a;
    border-radius: 0;
  }
</style>

<script>
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.bar-item').forEach((bar: Element) => {
          const el = bar as HTMLElement;
          el.style.width = el.dataset.width || '0%';
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });
  document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));

  document.querySelectorAll('.fullscreen-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.glass') as HTMLElement;
      if (!document.fullscreenElement) {
        card.requestFullscreen();
      } else {
        document.exitFullscreen();
      }
    });
  });

  document.addEventListener('fullscreenchange', () => {
    document.querySelectorAll('.fullscreen-btn').forEach(btn => {
      const card = btn.closest('.glass');
      const isThisCard = document.fullscreenElement === card;
      (btn.querySelector('.expand-icon') as HTMLElement).classList.toggle('hidden', isThisCard);
      (btn.querySelector('.compress-icon') as HTMLElement).classList.toggle('hidden', !isThisCard);
    });
  });
</script>
