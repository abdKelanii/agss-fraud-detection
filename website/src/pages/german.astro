---
import Layout from '../layouts/Layout.astro';

const overRows = [
  { model:'XGBoost',     f1:0.8386, color:'#10b981' },
  { model:'LightGBM',    f1:0.8343, color:'#34d399' },
  { model:'RNN',         f1:0.8294, color:'#a78bfa' },
  { model:'LSTM',        f1:0.8286, color:'#818cf8' },
  { model:'Transformer', f1:0.8241, color:'#c084fc' },
  { model:'GAN',         f1:0.8235, color:'#f59e0b' },
];
const paperTarget = 0.8489;
---

<Layout title="German Credit Results">
  <section class="max-w-6xl mx-auto px-6 py-20">

    <div data-animate class="mb-12">
      <p class="text-xs font-semibold text-purple-400 uppercase tracking-widest mb-2">Phase 2</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">German Credit Dataset</h1>
      <p class="text-gray-400 max-w-2xl">
        1,000 samples · 300 bad credit (30%) · 20 mixed features.
        Metric: <strong class="text-gray-200">F1-score on majority (good credit) class</strong>.
        Paper target: <span class="text-purple-400 font-mono font-bold">{paperTarget}</span> (RNN+AGSS over).
      </p>
    </div>

    <!-- F1 bars -->
    <div data-animate class="glass rounded-2xl p-8 mb-8">
      <h2 class="text-lg font-bold text-white mb-6">F1 (good class) — All Models + AGSS</h2>
      {overRows.map((r, i) => (
        <div class="mb-5">
          <div class="flex justify-between items-center mb-1.5">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full" style={`background:${r.color}`}></span>
              <span class="text-sm font-semibold text-gray-200">{r.model}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="font-mono font-bold text-sm" style={`color:${r.color}`}>{r.f1.toFixed(4)}</span>
              <span class={`text-xs font-bold px-2 py-0.5 rounded-full
                ${r.f1 >= paperTarget ? 'bg-accent-500/20 text-accent-400' : 'bg-white/5 text-gray-500'}`}>
                {r.f1 >= paperTarget ? '+' : ''}{((r.f1 - paperTarget)*100).toFixed(1)}%
              </span>
            </div>
          </div>
          <div class="relative h-3 bg-white/5 rounded-full overflow-hidden">
            <div class="h-full rounded-full bar-item"
                 style={`width:0%; background:${r.color}; transition: width 1s ease ${i*100}ms`}
                 data-width={`${(r.f1/0.9)*100}%`}></div>
            <div class="absolute top-0 bottom-0 w-px bg-white/30"
                 style={`left:${(paperTarget/0.9)*100}%`}></div>
          </div>
        </div>
      ))}
      <p class="text-xs text-gray-500 mt-2">Vertical line = paper RNN+AGSS target ({paperTarget})</p>
    </div>

    <!-- Transformer tuning highlight -->
    <div data-animate class="glass rounded-2xl p-8 mb-8 border-purple-500/20 bg-purple-500/5">
      <h2 class="text-lg font-bold text-white mb-4">Transformer d_model Tuning</h2>
      <p class="text-gray-400 text-sm mb-6">
        Default d_model=32 gave F1=0.7021 (14.7% gap). Grid search over d_model ∈ {'{'}64,128,256{'}'} × epochs ∈ {'{'}300,500{'}'} × lr ∈ {'{'}5e-4,2e-4{'}'} closed the gap to <span class="text-purple-400 font-bold">2.5%</span>.
      </p>
      <div class="grid grid-cols-3 gap-4">
        {[
          { label: 'Baseline (d=32)', value: '0.7021', color: 'text-rose-400' },
          { label: 'Best (d=128)',    value: '0.8241', color: 'text-purple-400' },
          { label: 'Paper Target',   value: '0.8489', color: 'text-gray-400' },
        ].map(item => (
          <div class="glass rounded-xl p-4 text-center">
            <p class={`text-2xl font-extrabold font-mono ${item.color}`}>{item.value}</p>
            <p class="text-xs text-gray-500 mt-1">{item.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Undersampling -->
    <div data-animate class="glass rounded-2xl p-8">
      <h2 class="text-lg font-bold text-white mb-4">Undersampling Results (RNN & LSTM)</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs text-gray-500 uppercase border-b border-white/5">
              <th class="px-4 py-3 text-left">Model</th>
              <th class="px-4 py-3 text-left">Sampler</th>
              <th class="px-4 py-3 text-right">F1 (good)</th>
              <th class="px-4 py-3 text-right">ROC-AUC</th>
            </tr>
          </thead>
          <tbody>
            {[
              { model:'RNN',  sampler:'TomekLinks', f1:0.8328, roc:0.7423, best:true  },
              { model:'RNN',  sampler:'RUS',        f1:0.8298, roc:0.7362, best:false },
              { model:'RNN',  sampler:'AGSS',       f1:0.8145, roc:0.6994, best:false },
              { model:'LSTM', sampler:'TomekLinks', f1:0.8297, roc:0.7229, best:false },
              { model:'LSTM', sampler:'RUS',        f1:0.8287, roc:0.7125, best:false },
            ].map(r => (
              <tr class="border-b border-white/5 hover:bg-white/3 transition-colors">
                <td class="px-4 py-3 font-semibold text-gray-200">{r.model}</td>
                <td class="px-4 py-3 text-gray-400">{r.sampler}</td>
                <td class="px-4 py-3 text-right font-mono font-bold text-purple-400">{r.f1.toFixed(4)}</td>
                <td class="px-4 py-3 text-right font-mono text-gray-400">{r.roc.toFixed(4)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500 mt-3">Paper RNN+AGSS under target: 0.8601 (3.2% gap)</p>
    </div>

  </section>
</Layout>

<script>
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.bar-item').forEach((bar: Element) => {
          const el = bar as HTMLElement;
          el.style.width = el.dataset.width || '0%';
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });
  document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
</script>
