---
import Layout from '../layouts/Layout.astro';
import ResultBar from '../components/ResultBar.astro';

const overRows = [
  { model:'LightGBM', f1:0.8734, prec:0.9434, rec:0.8130, roc:0.9808, color:'#34d399', beat:true  },
  { model:'XGBoost',  f1:0.8656, prec:0.9447, rec:0.7988, roc:0.9814, color:'#10b981', beat:true  },
  { model:'LSTM',     f1:0.8236, prec:0.8706, rec:0.7866, roc:0.9728, color:'#818cf8', beat:false },
  { model:'RNN',      f1:0.8077, prec:0.8372, rec:0.7967, roc:0.9780, color:'#a78bfa', beat:false },
  { model:'GAN',      f1:0.7497, prec:0.8367, rec:0.6606, roc:0.9574, color:'#f59e0b', beat:false },
  { model:'Transformer',f1:0.3922,prec:0.3367,rec:0.4695, roc:0.9208, color:'#c084fc', beat:false },
];
const paperCC = 0.8333;
---

<Layout title="Credit Card Results">
  <section class="max-w-6xl mx-auto px-6 py-20">

    <div data-animate class="mb-12">
      <p class="text-xs font-semibold text-primary-400 uppercase tracking-widest mb-2">Phase 1</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Credit Card Dataset</h1>
      <p class="text-gray-400 max-w-2xl">
        284,807 transactions · 492 fraud (0.17%) · 30 PCA features.
        Evaluated with 5-fold stratified CV. Metric: <strong class="text-gray-200">F1-score on fraud class</strong>.
        Paper target: <span class="text-primary-400 font-mono font-bold">{paperCC}</span> (LSTM+AGSS).
      </p>
    </div>

    <!-- F1 comparison bars -->
    <div data-animate class="glass rounded-2xl p-8 mb-8">
      <h2 class="text-lg font-bold text-white mb-6">F1-Score Comparison (AGSS oversampling)</h2>
      {overRows.map((r, i) => (
        <div class="mb-5">
          <div class="flex justify-between items-center mb-1.5">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full" style={`background:${r.color}`}></span>
              <span class="text-sm font-semibold text-gray-200">{r.model}</span>
              {r.beat && <span class="text-xs px-2 py-0.5 rounded-full bg-accent-500/20 text-accent-400 font-bold">beats paper</span>}
            </div>
            <span class="font-mono font-bold text-sm" style={`color:${r.color}`}>{r.f1.toFixed(4)}</span>
          </div>
          <div class="relative h-3 bg-white/5 rounded-full overflow-hidden">
            <div class="h-full rounded-full bar-item"
                 style={`width:0%; background:${r.color}; transition: width 1s ease ${i*120}ms`}
                 data-width={`${(r.f1/1)*100}%`}></div>
            <div class="absolute top-0 bottom-0 w-px bg-white/30" style={`left:${paperCC*100}%`}></div>
          </div>
        </div>
      ))}
      <p class="text-xs text-gray-500 mt-4">Vertical line = paper LSTM+AGSS target ({paperCC})</p>
    </div>

    <!-- Detailed table -->
    <div data-animate class="glass rounded-2xl overflow-hidden mb-8">
      <div class="p-6 border-b border-white/5">
        <h2 class="text-lg font-bold text-white">Detailed Metrics</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-xs text-gray-500 uppercase border-b border-white/5">
              <th class="px-6 py-3 text-left">Model</th>
              <th class="px-6 py-3 text-right">F1</th>
              <th class="px-6 py-3 text-right">Precision</th>
              <th class="px-6 py-3 text-right">Recall</th>
              <th class="px-6 py-3 text-right">ROC-AUC</th>
              <th class="px-6 py-3 text-right">vs Paper</th>
            </tr>
          </thead>
          <tbody>
            {overRows.map((r, i) => (
              <tr class={`border-b border-white/5 transition-colors hover:bg-white/3
                          ${i % 2 === 0 ? 'bg-white/1' : ''}`}>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full" style={`background:${r.color}`}></span>
                    <span class="font-semibold text-gray-200">{r.model}</span>
                  </div>
                </td>
                <td class="px-6 py-4 text-right font-mono font-bold" style={`color:${r.color}`}>{r.f1.toFixed(4)}</td>
                <td class="px-6 py-4 text-right font-mono text-gray-300">{r.prec.toFixed(4)}</td>
                <td class="px-6 py-4 text-right font-mono text-gray-300">{r.rec.toFixed(4)}</td>
                <td class="px-6 py-4 text-right font-mono text-gray-300">{r.roc.toFixed(4)}</td>
                <td class="px-6 py-4 text-right">
                  <span class={`text-xs font-bold px-2 py-1 rounded-full
                    ${r.f1 >= paperCC ? 'bg-accent-500/20 text-accent-400' : 'bg-rose-500/10 text-rose-400'}`}>
                    {r.f1 >= paperCC ? '+' : ''}{((r.f1 - paperCC) * 100).toFixed(1)}%
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Undersampling summary -->
    <div data-animate class="glass rounded-2xl p-8">
      <h2 class="text-lg font-bold text-white mb-4">Undersampling Results</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {[
          { model:'LSTM+AGSS', f1:'0.8238', thresh:'0.985', note:'4.6% gap from paper (0.8636)' },
          { model:'RNN+AGSS',  f1:'0.8218', thresh:'0.90',  note:'Beats paper RNN+TomekLinks (+2.1%)' },
        ].map(r => (
          <div class="glass rounded-xl p-5">
            <p class="font-bold text-white mb-1">{r.model}</p>
            <p class="text-3xl font-extrabold text-primary-400 font-mono">{r.f1}</p>
            <p class="text-xs text-gray-500 mt-1">threshold = {r.thresh}</p>
            <p class="text-xs text-gray-400 mt-2">{r.note}</p>
          </div>
        ))}
      </div>
    </div>

  </section>
</Layout>

<script>
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.querySelectorAll('.bar-item').forEach((bar: Element) => {
          const el = bar as HTMLElement;
          el.style.width = el.dataset.width || '0%';
        });
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });
  document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
</script>
